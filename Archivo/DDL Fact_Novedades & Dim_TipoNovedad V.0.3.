-- ============================================================
-- 1. dim_Tipo_Novedad
-- Dimension de dominio cerrado para catalogar eventos de RRHH.
-- 3 campos, 6 registros fijos. No crece en el MVP.
-- ============================================================
CREATE TABLE dim_Tipo_Novedad (

    ID_Tipo_Novedad     SMALLINT        NOT NULL,
    Tipo_Novedad        VARCHAR(50)     NOT NULL,

    -- Movimiento Externo: eventos que implican entrada o salida de la firma.
    -- Movimiento Interno: eventos que ocurren dentro de la firma.
    Categoria           VARCHAR(30)     NOT NULL,

    CONSTRAINT pk_dim_Tipo_Novedad
        PRIMARY KEY (ID_Tipo_Novedad),

    CONSTRAINT chk_tipo_novedad
        CHECK (Tipo_Novedad IN (
            'Ingreso',
            'Cese Voluntario',
            'Cese Involuntario',
            'Ascenso',
            'Cambio de Proyecto',
            'Cambio de Supervisor'
        )),

    CONSTRAINT chk_categoria_novedad
        CHECK (Categoria IN (
            'Movimiento Externo',
            'Movimiento Interno'
        ))

);

COMMENT ON TABLE dim_Tipo_Novedad IS
    'Dimension de dominio cerrado para eventos de RRHH. '
    'Movimiento Externo: ingresos y ceses. '
    'Movimiento Interno: ascensos, cambios de proyecto y supervisor. '
    '6 registros fijos. No crece en el MVP.';

COMMENT ON COLUMN dim_Tipo_Novedad.Categoria IS
    'Movimiento Externo = entrada o salida de la firma. '
    'Movimiento Interno = movimiento dentro de la estructura organizacional.';


