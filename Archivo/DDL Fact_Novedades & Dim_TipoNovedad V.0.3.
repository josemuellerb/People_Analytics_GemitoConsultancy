-- ============================================================
-- 2. fact_Novedades
-- Tabla de hechos transaccional de eventos de RRHH.
-- Granularidad: una fila por evento por asociado afectado.
-- ============================================================
CREATE TABLE fact_Novedades (

    -- ----------------------------------------------------------
    -- LLAVE SURROGATE
    -- ----------------------------------------------------------
    ID_Fact_Novedad             SERIAL          NOT NULL,

    -- ----------------------------------------------------------
    -- ROLE-PLAYING EN CALENDARIO
    -- Dos fechas distintas para separar operación RRHH de impacto en nómina.
    -- Ambas FK a dim_Calendario.
    -- Fecha_Registro_Llave: relación ACTIVA por defecto en Power BI.
    -- Fecha_Efectiva_Llave: relación INACTIVA, activar con USERELATIONSHIP
    --   cuando se analiza impacto real en planilla.
    -- Ejemplo: ascenso solicitado el 15 enero con efectividad 01 febrero
    --   → Fecha_Registro = 15 enero | Fecha_Efectiva = 01 febrero.
    -- ----------------------------------------------------------
    Fecha_Registro_Llave        DATE            NOT NULL,
    Fecha_Efectiva_Llave        DATE            NOT NULL,

    -- ----------------------------------------------------------
    -- DIMENSIONES
    -- ----------------------------------------------------------

    -- Empleado afectado por la novedad.
    -- FK → dim_Asociados (relacion activa)
    ID_Asociado                 VARCHAR(10)     NOT NULL,

    -- Actor que genera la novedad.
    -- En Cese: apunta al supervisor cesado.
    -- En Cambio de Supervisor: apunta al nuevo supervisor asignado.
    -- En Ingreso: usar GC000 (no hay actor previo).
    -- REGLA ETL: GC000 solo es válido cuando ID_Tipo_Novedad = 1 (Ingreso).
    -- FK → dim_Asociados (role-playing, relacion inactiva en Power BI)
    ID_Asociado_Relacionado     VARCHAR(10)     NOT NULL,

    -- Puesto del asociado ANTES del evento.
    -- En Ingreso: puesto al que ingresa (Origen = Destino).
    -- En Cese: puesto que ocupaba al momento del cese (Origen = Destino).
    -- FK → dim_Piramide SCD Tipo 2
    ID_Piramide_Origen          INT             NOT NULL,

    -- Puesto del asociado DESPUES del evento.
    -- Permite construir matrices de transicion y diagramas Sankey en Power BI.
    -- FK → dim_Piramide SCD Tipo 2
    ID_Piramide_Destino         INT             NOT NULL,

    -- Proyecto del asociado ANTES del evento.
    -- O000 para colaboradores de Back-Office.
    -- FK → dim_Operaciones
    ID_Operacion_Origen         VARCHAR(10)     NOT NULL,

    -- Proyecto del asociado DESPUES del evento.
    -- Permite analizar flujo de talento entre proyectos.
    -- FK → dim_Operaciones
    ID_Operacion_Destino        VARCHAR(10)     NOT NULL,

    -- Tipo de evento ocurrido.
    -- FK → dim_Tipo_Novedad
    ID_Tipo_Novedad             SMALLINT        NOT NULL,

    -- ----------------------------------------------------------
    -- LINAJE PADRE/HIJO
    -- Permite rastrear eventos en cascada.
    -- NULL en eventos primarios (el cese en sí).
    -- Apunta al ID_Fact_Novedad del cese para todas las filas
    -- secundarias de Cambio de Supervisor que disparó.
    -- Ejemplo: cese de un Coordinador (ID=100) dispara 5 filas
    -- de Cambio de Supervisor con ID_Fact_Novedad_Padre = 100.
    -- ----------------------------------------------------------
    ID_Fact_Novedad_Padre       INT             NULL,

    -- ----------------------------------------------------------
    -- ESTADO Y FLUJO DE APROBACION
    -- ----------------------------------------------------------

    -- Estado actual de la novedad en el flujo de aprobacion.
    Estado_Novedad              VARCHAR(20)     NOT NULL    DEFAULT 'En Revisión',

    -- Timestamp de registro de la novedad en el sistema RRHH.
    Fecha_Ingreso               TIMESTAMP       NOT NULL    DEFAULT CURRENT_TIMESTAMP,

    -- Timestamp de resolución. NULL mientras esté En Revisión.
    Fecha_Aprobacion            TIMESTAMP       NULL,

    -- ----------------------------------------------------------
    -- CAMPOS DE IMPACTO (calculados por el ETL)
    -- ----------------------------------------------------------

    -- TRUE si el evento es un cese de nivel Coordinador o superior
    -- (Orden_Nivel_Jerarquico >= 3 en dim_Piramide).
    -- El ETL cruza ID_Tipo_Novedad con Orden_Nivel_Jerarquico para calcularlo.
    -- TRUE dispara la generacion de filas secundarias de Cambio de Supervisor.
    Genera_Eventos_Secundarios  BOOLEAN         NOT NULL    DEFAULT FALSE,

    -- SLA de cobertura de la plaza vacante.
    -- 45 dias: cese de Coordinador o superior (Orden >= 3).
    -- 30 dias: cese de Analista o inferior (Orden < 3).
    -- NULL: eventos que no generan plaza vacante (Ascenso, Cambio de Proyecto,
    --       Cambio de Supervisor, Ingreso).
    -- Conexion Fase 2: fact_Seleccion medirá cumplimiento de este SLA.
    Dias_Estandar_Cobertura     SMALLINT        NULL,

    -- ----------------------------------------------------------
    -- OPTIMIZACION VERTIPAQ
    -- Campo aditivo para conteo eficiente en Power BI.
    -- SUM(Cantidad_Eventos) es mas rapido que COUNTROWS en DAX.
    -- ----------------------------------------------------------
    Cantidad_Eventos            SMALLINT        NOT NULL    DEFAULT 1,

    -- ----------------------------------------------------------
    -- AUDITORIA
    -- ----------------------------------------------------------
    Fecha_Carga_DW              TIMESTAMP       NOT NULL    DEFAULT CURRENT_TIMESTAMP,

    -- ----------------------------------------------------------
    -- PRIMARY KEY
    -- ----------------------------------------------------------
    CONSTRAINT pk_fact_Novedades
        PRIMARY KEY (ID_Fact_Novedad),

    -- ----------------------------------------------------------
    -- FOREIGN KEYS
    -- ----------------------------------------------------------
    CONSTRAINT fk_novedades_calendario_registro
        FOREIGN KEY (Fecha_Registro_Llave)
        REFERENCES dim_Calendario (Fecha_Llave),

    CONSTRAINT fk_novedades_calendario_efectiva
        FOREIGN KEY (Fecha_Efectiva_Llave)
        REFERENCES dim_Calendario (Fecha_Llave),

    CONSTRAINT fk_novedades_asociado
        FOREIGN KEY (ID_Asociado)
        REFERENCES dim_Asociados (ID_Asociado),

    CONSTRAINT fk_novedades_asociado_relacionado
        FOREIGN KEY (ID_Asociado_Relacionado)
        REFERENCES dim_Asociados (ID_Asociado),

    CONSTRAINT fk_novedades_piramide_origen
        FOREIGN KEY (ID_Piramide_Origen)
        REFERENCES dim_Piramide (ID_Piramide_Tecnico),

    CONSTRAINT fk_novedades_piramide_destino
        FOREIGN KEY (ID_Piramide_Destino)
        REFERENCES dim_Piramide (ID_Piramide_Tecnico),

    CONSTRAINT fk_novedades_operacion_origen
        FOREIGN KEY (ID_Operacion_Origen)
        REFERENCES dim_Operaciones (ID_Operacion),

    CONSTRAINT fk_novedades_operacion_destino
        FOREIGN KEY (ID_Operacion_Destino)
        REFERENCES dim_Operaciones (ID_Operacion),

    CONSTRAINT fk_novedades_tipo
        FOREIGN KEY (ID_Tipo_Novedad)
        REFERENCES dim_Tipo_Novedad (ID_Tipo_Novedad),

    -- Autorreferencia para linaje padre/hijo. Nullable: NULL en eventos primarios.
    CONSTRAINT fk_novedades_padre
        FOREIGN KEY (ID_Fact_Novedad_Padre)
        REFERENCES fact_Novedades (ID_Fact_Novedad),

    -- ----------------------------------------------------------
    -- CHECK CONSTRAINTS
    -- ----------------------------------------------------------

    -- El actor relacionado no puede ser el mismo empleado afectado.
    -- La cuspide organizacional usa GC000, no su propio ID.
    CONSTRAINT chk_asociados_distintos
        CHECK (ID_Asociado != ID_Asociado_Relacionado),

    CONSTRAINT chk_estado_novedad
        CHECK (Estado_Novedad IN ('En Revisión', 'Aprobado', 'Rechazado')),

    -- La aprobacion siempre es posterior al ingreso.
    CONSTRAINT chk_fechas_aprobacion
        CHECK (Fecha_Aprobacion IS NULL OR Fecha_Aprobacion >= Fecha_Ingreso),

    -- La fecha efectiva no puede ser anterior a la fecha de registro.
    CONSTRAINT chk_fechas_efectiva
        CHECK (Fecha_Efectiva_Llave >= Fecha_Registro_Llave),

    CONSTRAINT chk_dias_cobertura
        CHECK (Dias_Estandar_Cobertura IS NULL OR
               Dias_Estandar_Cobertura IN (30, 45)),

    CONSTRAINT chk_cantidad_eventos
        CHECK (Cantidad_Eventos = 1)

);

COMMENT ON TABLE fact_Novedades IS
    'Tabla de hechos transaccional de eventos de RRHH. '
    'Granularidad: una fila por evento por asociado afectado. '
    'Cese de Coordinador o superior dispara filas secundarias de Cambio de Supervisor '
    'enlazadas via ID_Fact_Novedad_Padre. '
    'Fecha_Registro_Llave = relacion activa en Power BI. '
    'Fecha_Efectiva_Llave = relacion inactiva, activar con USERELATIONSHIP para impacto en planilla.';

COMMENT ON COLUMN fact_Novedades.ID_Piramide_Origen IS
    'Puesto antes del evento. '
    'En Ingreso y Cese: mismo valor que ID_Piramide_Destino. '
    'En Ascenso y Cambio de Proyecto: puesto previo al movimiento.';

COMMENT ON COLUMN fact_Novedades.ID_Piramide_Destino IS
    'Puesto despues del evento. '
    'Permite construir matrices de transicion y Sankey en Power BI. '
    'En Ingreso y Cese: mismo valor que ID_Piramide_Origen.';

COMMENT ON COLUMN fact_Novedades.ID_Fact_Novedad_Padre IS
    'Autorreferencia para linaje padre/hijo. '
    'NULL en eventos primarios. '
    'En filas secundarias de Cambio de Supervisor: apunta al ID del cese que las disparó. '
    'Permite calcular cuantos cambios genero la salida de un colaborador.';

COMMENT ON COLUMN fact_Novedades.Fecha_Efectiva_Llave IS
    'Fecha en que el evento impacta en planilla. '
    'Relacion INACTIVA en Power BI. '
    'Activar con: USERELATIONSHIP(fact_Novedades[Fecha_Efectiva_Llave], dim_Calendario[Fecha_Llave]).';

COMMENT ON COLUMN fact_Novedades.Dias_Estandar_Cobertura IS
    'SLA de cobertura de plaza vacante. '
    '45 dias: cese de Coordinador o superior. '
    '30 dias: cese de Analista o inferior. '
    'NULL: eventos sin plaza vacante. '
    'fact_Seleccion en Fase 2 medirá cumplimiento de este SLA.';


-- ============================================================
-- INDICES DE PERFORMANCE
-- ============================================================

-- Eje temporal principal (relacion activa).
CREATE INDEX idx_fact_novedades_fecha_registro
    ON fact_Novedades (Fecha_Registro_Llave);

-- Eje temporal secundario (relacion inactiva).
CREATE INDEX idx_fact_novedades_fecha_efectiva
    ON fact_Novedades (Fecha_Efectiva_Llave);

-- Trayectoria individual del colaborador.
CREATE INDEX idx_fact_novedades_asociado
    ON fact_Novedades (ID_Asociado);

-- Linaje padre/hijo para rastreo de cascadas.
CREATE INDEX idx_fact_novedades_padre
    ON fact_Novedades (ID_Fact_Novedad_Padre)
    WHERE ID_Fact_Novedad_Padre IS NOT NULL;

-- Filtrado por tipo de evento (KPI mas frecuente).
CREATE INDEX idx_fact_novedades_tipo
    ON fact_Novedades (ID_Tipo_Novedad);
