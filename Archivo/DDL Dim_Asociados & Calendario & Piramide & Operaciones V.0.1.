-- 4. dim_Operaciones
-- Eje de Proyectos y Rentabilidad · Dummy Record Kimball
-- ============================================================
CREATE TABLE dim_Operaciones (

    ID_Operacion            VARCHAR(10)     NOT NULL,
    Nombre_Proyecto         VARCHAR(100)    NOT NULL,
    Fecha_Inicio            DATE            NOT NULL,
    Fecha_Finalizacion      DATE            NULL,
    Presupuesto_Asignado    NUMERIC(12,2)   NOT NULL    DEFAULT 0.00,
    Meta_Facturacion        NUMERIC(12,2)   NOT NULL    DEFAULT 0.00,
    Estado_Proyecto         VARCHAR(20)     NOT NULL,

    CONSTRAINT pk_dim_Operaciones
        PRIMARY KEY (ID_Operacion),

    CONSTRAINT chk_estado_proyecto
        CHECK (Estado_Proyecto IN ('Activo', 'Cerrado', 'Suspendido')),

    CONSTRAINT chk_fechas_operacion
        CHECK (Fecha_Finalizacion IS NULL OR Fecha_Finalizacion >= Fecha_Inicio),

    CONSTRAINT chk_presupuesto
        CHECK (Presupuesto_Asignado >= 0),

    CONSTRAINT chk_meta_facturacion
        CHECK (Meta_Facturacion >= 0)

);

COMMENT ON TABLE dim_Operaciones IS
    'Dimensión de proyectos y rentabilidad. '
    'O000 = Dummy Record Kimball para personal de soporte (evita NULLs en cálculo de margen). '
    'Calcular márgenes con SUMX en DAX para evitar doble conteo.';

