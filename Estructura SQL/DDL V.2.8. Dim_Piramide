-- ============================================================
-- DDL V2.8 | Gemito Consultancy | People Analytics MVP
-- Data Warehouse · Star Schema · PostgreSQL
-- Metodología Kimball | Mayo 2026
-- ============================================================
--
-- ORDEN DE EJECUCIÓN
--   1. dim_Calendario        (sin dependencias)
--   2. dim_Asociados         (sin dependencias)
--   3. dim_Piramide          (este archivo)
--   4. dim_Operaciones       (pendiente — FK futura hacia dim_Piramide)
--   5. fact_Planilla
--   6. fact_Novedades
--   7. fact_Ausentismo
--   8. fact_Desarrollo_Talento
--
-- FASES DEL PROYECTO
--   Fase 1 (2022)       : Datos sintéticos de arranque
--   Fase 2 (2023–2024)  : Expansión operativa
--   Fase 3 (2025–2026)  : Consolidación y analytics
--
-- DECISIONES DE DISEÑO CLAVE
--   [D1] SCD Tipo 2 ELIMINADO del MVP
--        Justificación: bandas salariales estables y sin traspasos de
--        departamento en el horizonte de 5 años. ID_Piramide VARCHAR(5)
--        opera como PK directa. Las facts referencian ID_Piramide sin
--        surrogate key intermedio.
--        Columnas eliminadas: ID_Piramide_Tecnico, Fecha_Vigencia_Desde,
--        Fecha_Vigencia_Hasta, Es_Vigente, uq_piramide_smart_vigencia.
--        Roadmap: implementar SCD2 con surrogate key en v2 cuando el
--        negocio requiera auditar cambios históricos de estructura.
--
--   [D2] Banda_Salarial_Midpoint como columna GENERATED ALWAYS AS STORED
--        Justificación: el Compa-ratio requiere el midpoint como
--        denominador. Generarlo en BD garantiza consistencia y evita
--        cálculos fila por fila en DAX.
--
--   [D3] Es_Puesto_Critico mantiene BOOLEAN
--        Justificación: no participa en operaciones aritméticas.
--        En Power BI se filtra directamente. Regla de negocio:
--        TRUE para Gerente y Jefe; FALSE para niveles inferiores.
--
--   [D4] Registro dummy '00000' incluido
--        Justificación: patrón Kimball de integridad referencial.
--        Absorbe filas de facts cuyo ID_Piramide no exista en el catálogo.
--        Todos sus valores son válidos dentro del dominio de constraints.
--
--   [D5] Plazas_Autorizadas BETWEEN 1 AND 170
--        Justificación: techo calibrado al máximo real del catálogo
--        (OOO01 = 162 plazas). El control de dotación total (500 plazas)
--        es responsabilidad del ETL, no de un CHECK de fila.
--
--   [D6] Departamento con CHECK de dominio cerrado
--        Los 7 departamentos oficiales más 'Desconocido' para el dummy.
--        Validación de catálogo cruzado con dim_Operaciones delegada al ETL.
--        FK formal hacia dim_Operaciones se añade con ALTER TABLE en v2.
--
--   [D7] Categoria_Rol — regla de asignación
--        'Core/Producción' : únicamente departamento Operaciones
--        'Terceros'        : puestos tercerizados (TTO01, AAO01, AAO02, AAO03)
--        'Back-Office'     : resto de departamentos
--        'Extranjero' en Tipo_Contrato_Esperado es modalidad contractual
--        por nacionalidad — no determina Categoria_Rol.
--
-- MONEDA GLOBAL DEL MODELO: PEN (Soles peruanos)
-- Centinela Kimball activos: '9999-12-31' (aplica al modelo global;
-- no usado en esta dimensión al eliminar SCD2)
-- ============================================================

CREATE TABLE dim_Piramide (

    -- ── CLAVE NATURAL ────────────────────────────────────────────────────
    -- PK directa tras eliminar SCD2. Patrón: [2 letras dept][1 letra nivel][2 dígitos]
    -- Ejemplo: OOA01 = Operaciones · Analista · secuencia 01
    -- Facts que referencian esta PK: fact_Planilla, fact_Novedades,
    --   fact_Ausentismo, fact_Desarrollo_Talento
    ID_Piramide             VARCHAR(5)      NOT NULL,

    -- ── CLASIFICACIÓN ORGANIZACIONAL ─────────────────────────────────────
    -- Departamento oficial. Dominio cerrado coordinado con dim_Operaciones.
    -- FK formal hacia dim_Operaciones pendiente para v2.
    Departamento            VARCHAR(100)    NOT NULL,

    -- Segmentación estratégica del puesto.
    -- 'Core/Producción' : Operaciones (cadena de valor directa)
    -- 'Back-Office'     : soporte interno
    -- 'Terceros'        : puestos operativos tercerizados
    -- KPI: distribución de headcount y costo por categoría
    Categoria_Rol           VARCHAR(30)     NOT NULL,

    -- Nombre oficial del cargo según estructura organizacional.
    -- KPI: headcount por cargo, rotación por cargo
    Cargo                   VARCHAR(100)    NOT NULL,

    -- ── JERARQUÍA ─────────────────────────────────────────────────────────
    -- Nivel jerárquico del puesto. Dominio cerrado de 6 niveles.
    -- KPI: pirámide organizacional, span of control
    Nivel_Jerarquico        VARCHAR(30)     NOT NULL,

    -- Orden numérico del nivel para ordenamiento en visualizaciones.
    -- Mapping garantizado por constraint cruzado con Nivel_Jerarquico:
    -- Practicante=0 | Operativo=1 | Analista=2 |
    -- Coordinador=3 | Jefe=4 | Gerente=5
    Orden_Nivel_Jerarquico  INT             NOT NULL,

    -- ── ATRIBUTOS DE PUESTO ───────────────────────────────────────────────
    -- TRUE para Gerente y Jefe. FALSE para niveles Coordinador e inferiores.
    -- KPI: cobertura de puestos críticos, riesgo de vacancia crítica
    Es_Puesto_Critico       BOOLEAN         NOT NULL    DEFAULT FALSE,

    -- Modalidad contractual esperada para el puesto.
    -- 'Extranjero' aplica por nacionalidad del asociado, no por nivel ni categoría.
    -- KPI: distribución de headcount por modalidad contractual
    Tipo_Contrato_Esperado  VARCHAR(50)     NOT NULL,

    -- ── BANDA SALARIAL (PEN — Soles peruanos) ────────────────────────────
    -- Límite inferior de la banda salarial del puesto. Moneda: PEN.
    -- KPI: masa salarial proyectada mínima, Compa-ratio
    Banda_Salarial_Min      NUMERIC(10,2)   NOT NULL,

    -- Límite superior de la banda salarial del puesto. Moneda: PEN.
    -- KPI: masa salarial proyectada máxima, Compa-ratio
    Banda_Salarial_Max      NUMERIC(10,2)   NOT NULL,

    -- Punto medio de la banda salarial. Columna generada — no insertar manualmente.
    -- Fórmula: (Banda_Salarial_Min + Banda_Salarial_Max) / 2. Moneda: PEN.
    -- KPI: Compa-ratio = Salario_Real / Banda_Salarial_Midpoint
    Banda_Salarial_Midpoint NUMERIC(10,2)   GENERATED ALWAYS AS
                                ((Banda_Salarial_Min + Banda_Salarial_Max) / 2.0) STORED,

    -- ── DOTACIÓN ──────────────────────────────────────────────────────────
    -- Número de plazas autorizadas para el puesto.
    -- El control de dotación total (500 plazas) es responsabilidad del ETL.
    -- KPI: cobertura de plazas, headcount vs. plazas autorizadas, vacantes
    Plazas_Autorizadas      INT             NOT NULL,

    -- ════════════════════════════════════════════════════════════════════
    -- CONSTRAINTS
    -- ════════════════════════════════════════════════════════════════════

    -- Clave primaria natural — única PK tras eliminación de SCD2
    CONSTRAINT pk_dim_Piramide
        PRIMARY KEY (ID_Piramide),

    -- Dominio cerrado de departamentos oficiales + 'Desconocido' para dummy
    CONSTRAINT chk_departamento_dominio
        CHECK (Departamento IN (
            'Gerencia Gral.',
            'Operaciones',
            'Comercial',
            'Finanzas',
            'RRHH & Legal',
            'Tecnología',
            'Administración',
            'Desconocido'
        )),

    -- Departamento y Cargo no pueden ser cadenas vacías o solo espacios
    CONSTRAINT chk_departamento_no_vacio
        CHECK (TRIM(Departamento) <> ''),

    CONSTRAINT chk_cargo_no_vacio
        CHECK (TRIM(Cargo) <> ''),

    -- Dominio cerrado de categorías de rol
    CONSTRAINT chk_categoria_rol
        CHECK (Categoria_Rol IN ('Core/Producción', 'Back-Office', 'Terceros')),

    -- Dominio cerrado de niveles jerárquicos
    CONSTRAINT chk_nivel_jerarquico
        CHECK (Nivel_Jerarquico IN (
            'Practicante', 'Operativo', 'Analista',
            'Coordinador', 'Jefe', 'Gerente'
        )),

    -- Rango válido de orden jerárquico
    CONSTRAINT chk_orden_nivel
        CHECK (Orden_Nivel_Jerarquico BETWEEN 0 AND 5),

    -- Mapping 1:1 garantizado entre Nivel_Jerarquico y Orden_Nivel_Jerarquico
    CONSTRAINT chk_orden_nivel_jerarquico_cruzado
        CHECK (
            (Nivel_Jerarquico = 'Practicante'  AND Orden_Nivel_Jerarquico = 0) OR
            (Nivel_Jerarquico = 'Operativo'    AND Orden_Nivel_Jerarquico = 1) OR
            (Nivel_Jerarquico = 'Analista'     AND Orden_Nivel_Jerarquico = 2) OR
            (Nivel_Jerarquico = 'Coordinador'  AND Orden_Nivel_Jerarquico = 3) OR
            (Nivel_Jerarquico = 'Jefe'         AND Orden_Nivel_Jerarquico = 4) OR
            (Nivel_Jerarquico = 'Gerente'      AND Orden_Nivel_Jerarquico = 5)
        ),

    -- Dominio cerrado de modalidades contractuales
    CONSTRAINT chk_tipo_contrato_esperado
        CHECK (Tipo_Contrato_Esperado IN (
            'Convenio Formativo', 'Plazo Fijo', 'Indeterminado', 'Extranjero'
        )),

    -- Convenio Formativo no aplica a niveles de liderazgo
    CONSTRAINT chk_contrato_jerarquia
        CHECK (NOT (
            Tipo_Contrato_Esperado = 'Convenio Formativo'
            AND Nivel_Jerarquico IN ('Jefe', 'Gerente')
        )),

    -- La banda salarial mínima debe ser positiva
    CONSTRAINT chk_banda_salarial_positiva
        CHECK (Banda_Salarial_Min > 0),

    -- El mínimo no puede superar al máximo
    CONSTRAINT chk_banda_salarial
        CHECK (Banda_Salarial_Min <= Banda_Salarial_Max),

    -- Plazas calibradas al máximo real del catálogo (OOO01 = 162)
    CONSTRAINT chk_plazas_autorizadas
        CHECK (Plazas_Autorizadas BETWEEN 1 AND 170)
);

-- ============================================================
-- COMENTARIOS DE TABLA Y COLUMNAS
-- ============================================================

COMMENT ON TABLE dim_Piramide IS
    'Dimensión de puestos de Gemito Consultancy. Modela el catálogo oficial '
    'de cargos, bandas salariales y dotación autorizada. '
    'PK natural: ID_Piramide. SCD Tipo 2 descartado en MVP — ver README. '
    'Moneda global del modelo: PEN (Soles peruanos).';

COMMENT ON COLUMN dim_Piramide.ID_Piramide IS
    'Clave natural del puesto. Patrón: [2L dept][1L nivel][2D seq]. '
    'Ejemplo: OOA01 = Operaciones·Analista·01. '
    'Valor reservado: 00000 = registro dummy Kimball.';

COMMENT ON COLUMN dim_Piramide.Departamento IS
    'Departamento oficial al que pertenece el puesto. '
    'Dominio cerrado de 7 valores + Desconocido (dummy). '
    'FK formal hacia dim_Operaciones pendiente para v2.';

COMMENT ON COLUMN dim_Piramide.Categoria_Rol IS
    'Segmentación estratégica del puesto. '
    'Core/Producción: Operaciones. '
    'Terceros: puestos tercerizados. '
    'Back-Office: soporte interno. '
    'Extranjero en Tipo_Contrato_Esperado es independiente de esta categoría.';

COMMENT ON COLUMN dim_Piramide.Cargo IS
    'Nombre oficial del cargo según estructura organizacional.';

COMMENT ON COLUMN dim_Piramide.Nivel_Jerarquico IS
    'Nivel jerárquico del puesto. Dominio: Practicante, Operativo, Analista, '
    'Coordinador, Jefe, Gerente. Mapping 1:1 con Orden_Nivel_Jerarquico.';

COMMENT ON COLUMN dim_Piramide.Orden_Nivel_Jerarquico IS
    'Orden numérico del nivel para visualizaciones y ordenamiento. '
    'Practicante=0 | Operativo=1 | Analista=2 | '
    'Coordinador=3 | Jefe=4 | Gerente=5.';

COMMENT ON COLUMN dim_Piramide.Es_Puesto_Critico IS
    'TRUE para Gerente y Jefe. FALSE para Coordinador e inferiores. '
    'Usado en KPIs de cobertura de puestos críticos y riesgo de vacancia.';

COMMENT ON COLUMN dim_Piramide.Tipo_Contrato_Esperado IS
    'Modalidad contractual esperada para el puesto. '
    'Extranjero aplica por nacionalidad del asociado — no determina Categoria_Rol. '
    'Dominio: Convenio Formativo, Plazo Fijo, Indeterminado, Extranjero.';

COMMENT ON COLUMN dim_Piramide.Banda_Salarial_Min IS
    'Límite inferior de la banda salarial. Moneda: PEN (Soles peruanos).';

COMMENT ON COLUMN dim_Piramide.Banda_Salarial_Max IS
    'Límite superior de la banda salarial. Moneda: PEN (Soles peruanos).';

COMMENT ON COLUMN dim_Piramide.Banda_Salarial_Midpoint IS
    'Punto medio de la banda salarial. Columna generada — no insertar manualmente. '
    'Fórmula: (Banda_Salarial_Min + Banda_Salarial_Max) / 2. Moneda: PEN. '
    'Denominador del Compa-ratio: Salario_Real / Banda_Salarial_Midpoint.';

COMMENT ON COLUMN dim_Piramide.Plazas_Autorizadas IS
    'Número de plazas autorizadas para el puesto. '
    'Techo calibrado al máximo real del catálogo (162 plazas). '
    'Control de dotación total (500 plazas) es responsabilidad del ETL.';

-- ============================================================
-- ÍNDICES
-- ============================================================

-- Filtros frecuentes en Power BI y ETL por departamento
CREATE INDEX idx_piramide_departamento
    ON dim_Piramide (Departamento);

-- Segmentación por categoría de rol en reportes de headcount y costo
CREATE INDEX idx_piramide_categoria_rol
    ON dim_Piramide (Categoria_Rol);

-- Filtros de pirámide organizacional y ordenamiento jerárquico
CREATE INDEX idx_piramide_nivel_jerarquico
    ON dim_Piramide (Nivel_Jerarquico, Orden_Nivel_Jerarquico);

-- Análisis de puestos críticos y cobertura
CREATE INDEX idx_piramide_puesto_critico
    ON dim_Piramide (Es_Puesto_Critico);

-- ============================================================
-- REGISTRO DUMMY KIMBALL
-- ============================================================
-- Propósito: absorber filas de facts cuyo ID_Piramide no exista
-- en el catálogo al momento de la carga. Garantiza integridad
-- referencial sin rechazar métricas reales.
-- Todos los valores son válidos dentro del dominio de constraints.

INSERT INTO dim_Piramide (
    ID_Piramide,
    Departamento,
    Categoria_Rol,
    Cargo,
    Nivel_Jerarquico,
    Orden_Nivel_Jerarquico,
    Es_Puesto_Critico,
    Tipo_Contrato_Esperado,
    Banda_Salarial_Min,
    Banda_Salarial_Max,
    Plazas_Autorizadas
) VALUES (
    '00000',            -- ID reservado — fuera del patrón de negocio
    'Desconocido',      -- valor especial incluido en chk_departamento_dominio
    'Back-Office',      -- valor válido del dominio cerrado
    'Desconocido',      -- pasa chk_cargo_no_vacio
    'Operativo',        -- valor válido del dominio cerrado
    1,                  -- Operativo = 1 — pasa chk_orden_nivel_jerarquico_cruzado
    FALSE,              -- no es puesto crítico
    'Plazo Fijo',       -- valor válido del dominio cerrado
    1.00,               -- > 0 — pasa chk_banda_salarial_positiva
    1.00,               -- Min = Max — pasa chk_banda_salarial
    1                   -- BETWEEN 1 AND 170 — pasa chk_plazas_autorizadas
    -- Banda_Salarial_Midpoint = 1.00 (GENERATED — no se inserta)
);

