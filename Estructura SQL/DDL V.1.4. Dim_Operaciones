CREATE INDEX idx_operaciones_estado
    ON dim_Operaciones (Estado_Proyecto);

-- Segmentación por cliente para análisis de rentabilidad
CREATE INDEX idx_operaciones_cliente
    ON dim_Operaciones (Cliente);

