-- ============================================================
-- DDL V.1.4. | Gemito Consultancy | People Analytics MVP
-- Data Warehouse · Star Schema · PostgreSQL
-- Metodología Kimball | Mayo 2026
-- ============================================================
--
-- ORDEN DE EJECUCIÓN
--   1. dim_Calendario        (sin dependencias)
--   2. dim_Asociados         (sin dependencias)
--   3. dim_Piramide          (sin dependencias externas en MVP)
--   4. dim_Operaciones       (este archivo)
--   5. fact_Planilla
--   6. fact_Novedades
--   7. fact_Ausentismo
--   8. fact_Desarrollo_Talento
--
-- FASES DEL PROYECTO
--   Fase 1 (2022)       : Proyectos Cóndor, Halcón, Nimbus — arranque operativo
--   Fase 2 (2023–2024)  : Proyectos Stratus, Orión, Vega, Kraken, Titán
--   Fase 3 (2025–2026)  : Proyectos Fénix, Helix — consolidación
--
-- DECISIONES DE DISEÑO CLAVE
--   [D1] PK natural VARCHAR(10) — SCD2 descartado en MVP
--        Justificación: los proyectos no cambian de atributos con frecuencia
--        en el horizonte 2022–2026. Surrogate key se implementa en v2
--        junto con SCD2 cuando el negocio requiera auditar cambios
--        históricos de proyectos.
--
--   [D2] Presupuesto_Asignado y Meta_Facturacion como atributos estáticos
--        Justificación: son techos autorizados por proyecto, no métricas
--        transaccionales. No varían por empleado ni por período.
--        No se suman contra fact_Planilla — se usan como denominadores
--        en medidas de eficiencia presupuestal en DAX con SUMX.
--        fact_Presupuestos_Operativos con granularidad temporal: Fase 2.
--
--   [D3] O000 es registro de negocio real — no dummy Kimball
--        Representa el Back-Office Corporativo (soporte interno).
--        Presupuesto_Asignado calculado sobre midpoints × plazas
--        de los ~167 colaboradores de soporte (S/ 6,645,000 anual).
--        Meta_Facturacion = 0.00 — el Back-Office no genera facturación.
--
--   [D4] Registro dummy independiente — '00000'
--        Absorbe filas de facts cuyo ID_Operacion no exista en catálogo.
--        Valores neutros válidos dentro del dominio de todos los constraints.
--
--   [D5] Fecha_Finalizacion admite NULL para proyectos activos
--        El centinela '9999-12-31' aplica a columnas SCD2 — no a fechas
--        de negocio. NULL es semánticamente correcto para proyectos sin
--        fecha de cierre definida. Tratamiento en DAX documentado en MD.
--
--   [D6] Tipo_Operacion distingue proyectos de Back-Office
--        Permite segmentar headcount, ausentismo y costos en Power BI
--        sin necesidad de filtros manuales por ID.
--
--   [D7] Cliente como atributo descriptivo libre
--        Sin FK externa. Permite segmentar rentabilidad por cliente
--        sin dependencia de una dimensión de clientes en el MVP.
--        dim_Clientes es candidato para Fase 2.
--
-- MONEDA GLOBAL DEL MODELO: PEN (Soles peruanos)
-- Centinela Kimball activos: '9999-12-31' (columnas SCD2 — no aplica aquí)
-- ============================================================

CREATE TABLE dim_Operaciones (

    -- ── CLAVE NATURAL ────────────────────────────────────────────────────
    -- PK directa. Patrón proyectos: P001–P010.
    -- Valores reservados: O000 = Back-Office Corporativo | 00000 = Dummy
    -- Facts que referencian esta PK: fact_Planilla, fact_Novedades,
    --   fact_Ausentismo, fact_Desarrollo_Talento
    ID_Operacion            VARCHAR(10)     NOT NULL,

    -- ── CLASIFICACIÓN ────────────────────────────────────────────────────
    -- Segmentación estratégica de la operación.
    -- 'Proyecto'    : genera facturación directa al cliente
    -- 'Back-Office' : soporte interno corporativo — Meta_Facturacion = 0
    -- KPI: headcount, ausentismo y costo por tipo de operación
    Tipo_Operacion          VARCHAR(20)     NOT NULL,

    -- ── IDENTIFICACIÓN ───────────────────────────────────────────────────
    -- Nombre oficial del proyecto u operación.
    -- KPI: rentabilidad por proyecto, costo laboral vs. presupuesto
    Nombre_Proyecto         VARCHAR(100)    NOT NULL,

    -- Cliente o industria asociada al proyecto.
    -- Atributo descriptivo libre — sin FK en MVP.
    -- KPI: rentabilidad por cliente, headcount por industria
    -- dim_Clientes como dimensión formal: Fase 2
    Cliente                 VARCHAR(100)    NOT NULL,

    -- ── CICLO DE VIDA ────────────────────────────────────────────────────
    -- Fecha de inicio del proyecto o de la operación Back-Office.
    Fecha_Inicio            DATE            NOT NULL,

    -- Fecha de cierre del proyecto. NULL = proyecto activo o sin fecha definida.
    -- No usar centinela '9999-12-31' — esta es una fecha de negocio, no SCD2.
    -- Tratamiento DAX: IF(ISBLANK(Fecha_Finalizacion), "Activo", FORMAT(...))
    Fecha_Finalizacion      DATE            NULL,

    -- ── FINANCIERO (PEN — Soles peruanos) ────────────────────────────────
    -- Techo presupuestal autorizado para el proyecto.
    -- Back-Office: calculado sobre midpoints × plazas (~S/ 6,645,000 anual).
    -- No sumar contra fact_Planilla directamente — usar SUMX en DAX.
    -- KPI: eficiencia presupuestal = costo real / presupuesto asignado
    Presupuesto_Asignado    NUMERIC(12,2)   NOT NULL    DEFAULT 0.00,

    -- Meta de facturación al cliente para el proyecto.
    -- Back-Office y Dummy: siempre 0.00 — no generan facturación.
    -- KPI: margen bruto = Meta_Facturacion - costo laboral real
    Meta_Facturacion        NUMERIC(12,2)   NOT NULL    DEFAULT 0.00,

    -- ── ESTADO ───────────────────────────────────────────────────────────
    -- Estado actual del proyecto.
    -- 'Activo'     : en ejecución
    -- 'Cerrado'    : finalizado
    -- 'Suspendido' : pausado temporalmente
    Estado_Proyecto         VARCHAR(20)     NOT NULL,

    -- ════════════════════════════════════════════════════════════════════
    -- CONSTRAINTS
    -- ════════════════════════════════════════════════════════════════════

    -- Clave primaria natural
    CONSTRAINT pk_dim_Operaciones
        PRIMARY KEY (ID_Operacion),

    -- Dominio cerrado de tipos de operación
    CONSTRAINT chk_tipo_operacion
        CHECK (Tipo_Operacion IN ('Proyecto', 'Back-Office', 'Dummy')),

    -- Nombre de proyecto no puede ser cadena vacía o solo espacios
    CONSTRAINT chk_nombre_no_vacio
        CHECK (TRIM(Nombre_Proyecto) <> ''),

    -- Cliente no puede ser cadena vacía o solo espacios
    CONSTRAINT chk_cliente_no_vacio
        CHECK (TRIM(Cliente) <> ''),

    -- Fecha de finalización debe ser igual o posterior a la de inicio
    CONSTRAINT chk_fechas_operacion
        CHECK (Fecha_Finalizacion IS NULL OR Fecha_Finalizacion >= Fecha_Inicio),

    -- Presupuesto no puede ser negativo
    CONSTRAINT chk_presupuesto
        CHECK (Presupuesto_Asignado >= 0),

    -- Meta de facturación no puede ser negativa
    CONSTRAINT chk_meta_facturacion
        CHECK (Meta_Facturacion >= 0),

    -- Back-Office y Dummy no pueden tener meta de facturación
    CONSTRAINT chk_no_proyecto_sin_meta
        CHECK (NOT (Tipo_Operacion IN ('Back-Office', 'Dummy')
               AND Meta_Facturacion > 0)),

    -- Dominio cerrado de estados
    CONSTRAINT chk_estado_proyecto
        CHECK (Estado_Proyecto IN ('Activo', 'Cerrado', 'Suspendido'))
);

-- ============================================================
-- COMENTARIOS DE TABLA Y COLUMNAS
-- ============================================================

COMMENT ON TABLE dim_Operaciones IS
    'Dimensión de proyectos y operaciones de Gemito Consultancy. '
    'Modela proyectos de rentabilidad directa y la operación Back-Office Corporativo. '
    'PK natural: ID_Operacion. SCD2 descartado en MVP — ver README. '
    'O000 = Back-Office Corporativo (negocio real, no dummy). '
    '00000 = Dummy Kimball de integridad referencial. '
    'Moneda global del modelo: PEN (Soles peruanos). '
    'Calcular márgenes con SUMX en DAX para evitar doble conteo.';

COMMENT ON COLUMN dim_Operaciones.ID_Operacion IS
    'Clave natural de la operación. '
    'Patrón proyectos: P001–P010. '
    'Reservados: O000 = Back-Office Corporativo | 00000 = Dummy Kimball.';

COMMENT ON COLUMN dim_Operaciones.Tipo_Operacion IS
    'Segmentación estratégica: Proyecto = facturación directa, '
    'Back-Office = soporte interno, Dummy = registro Kimball.';

COMMENT ON COLUMN dim_Operaciones.Nombre_Proyecto IS
    'Nombre oficial del proyecto u operación.';

COMMENT ON COLUMN dim_Operaciones.Cliente IS
    'Cliente o industria asociada. Atributo libre en MVP. '
    'dim_Clientes como dimensión formal: Fase 2.';

COMMENT ON COLUMN dim_Operaciones.Fecha_Inicio IS
    'Fecha de inicio del proyecto o de la operación Back-Office.';

COMMENT ON COLUMN dim_Operaciones.Fecha_Finalizacion IS
    'Fecha de cierre del proyecto. NULL = activo o sin fecha definida. '
    'No es columna SCD2 — no usar centinela 9999-12-31. '
    'DAX: IF(ISBLANK(Fecha_Finalizacion), "Activo", FORMAT(...))';

COMMENT ON COLUMN dim_Operaciones.Presupuesto_Asignado IS
    'Techo presupuestal autorizado. Moneda: PEN. '
    'Back-Office: suma de midpoints x plazas (~S/ 6,645,000 anual). '
    'No sumar directamente contra fact_Planilla — usar SUMX en DAX.';

COMMENT ON COLUMN dim_Operaciones.Meta_Facturacion IS
    'Meta de facturación al cliente. Moneda: PEN. '
    'Back-Office y Dummy: siempre 0.00.';

COMMENT ON COLUMN dim_Operaciones.Estado_Proyecto IS
    'Estado actual: Activo, Cerrado, Suspendido.';

