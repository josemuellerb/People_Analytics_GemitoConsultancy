-- ============================================================
-- 1. dim_Estado_Nomina
-- Dominio cerrado de estados laborales mensuales.
-- 5 registros fijos. No crece en el MVP.
-- Fuente de verdad única para el KPI de Headcount Activo.
-- ============================================================
CREATE TABLE dim_Estado_Nomina (

    ID_Estado_Nomina    SMALLINT        NOT NULL,
    Estado              VARCHAR(50)     NOT NULL,

    -- Fuente de verdad de headcount. NO duplicar este flag en fact_Planilla.
    -- TRUE  → Activo Regular, Licencia Con Goce
    -- FALSE → Licencia Sin Goce, Cesado, Suspendido
    Es_Headcount_Activo BOOLEAN         NOT NULL,

    -- Definición operacional para el diccionario de datos.
    Descripcion         VARCHAR(200)    NOT NULL,

    CONSTRAINT pk_dim_Estado_Nomina
        PRIMARY KEY (ID_Estado_Nomina),

    CONSTRAINT chk_estado_valores
        CHECK (Estado IN (
            'Activo Regular',
            'Licencia Con Goce',
            'Licencia Sin Goce',
            'Cesado',
            'Suspendido'
        ))

);

COMMENT ON TABLE dim_Estado_Nomina IS
    'Dimension maestra de estados de nomina. Dominio cerrado: 5 registros fijos. '
    'Es_Headcount_Activo es la fuente de verdad unica para el KPI de headcount activo. '
    'No duplicar ese flag en fact_Planilla.';

COMMENT ON COLUMN dim_Estado_Nomina.Es_Headcount_Activo IS
    'TRUE solo para Activo Regular y Licencia Con Goce. '
    'Medida DAX base: CALCULATE(SUM(fact_Planilla[Headcount]), '
    'dim_Estado_Nomina[Es_Headcount_Activo] = TRUE)';


