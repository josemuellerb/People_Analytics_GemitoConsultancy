-- ============================================================
-- 2. fact_Planilla
-- Tabla de hechos principal del modelo.
-- Granularidad: Periodic Snapshot (1 fila por empleado por mes).
-- Ejecutar despues de todas las dimensiones y dummy records.
-- ============================================================
CREATE TABLE fact_Planilla (

    -- ----------------------------------------------------------
    -- LLAVES Y DIMENSIONES
    -- ----------------------------------------------------------

    -- Llave surrogate de la fact. No tiene significado de negocio.
    ID_Fact_Planilla    SERIAL          NOT NULL,

    -- Eje temporal. Usar primer dia habil del mes como convencion.
    -- FK → dim_Calendario
    Fecha_Llave         DATE            NOT NULL,

    -- Empleado registrado en el snapshot mensual.
    -- FK → dim_Asociados (relacion activa en Power BI)
    ID_Asociado         VARCHAR(10)     NOT NULL,

    -- Surrogate key SCD Tipo 2. Congela la banda salarial exacta
    -- vigente en el mes. NUNCA usar ID_Piramide como FK.
    -- FK → dim_Piramide
    ID_Piramide_Tecnico INT             NOT NULL,

    -- Proyecto al que se imputa el costo del colaborador ese mes.
    -- NOT NULL: usar O000 para colaboradores de Back-Office.
    -- FK → dim_Operaciones
    ID_Operacion        VARCHAR(10)     NOT NULL    DEFAULT 'O000',

    -- Role-playing dimension sobre dim_Asociados.
    -- Congela la linea de reporte vigente en el mes.
    -- RELACION INACTIVA en Power BI. Activar con:
    --   USERELATIONSHIP(fact_Planilla[ID_Supervisor], dim_Asociados[ID_Asociado])
    -- Usar GC000 para colaboradores sin supervisor (cuspide de piramide).
    -- FK → dim_Asociados (relacion inactiva en Power BI)
    ID_Supervisor       VARCHAR(10)     NOT NULL    DEFAULT 'GC000',

    -- Estado laboral del empleado en el mes registrado.
    -- Fuente de verdad para headcount activo via Es_Headcount_Activo.
    -- FK → dim_Estado_Nomina
    ID_Estado_Nomina    SMALLINT        NOT NULL,

    -- ----------------------------------------------------------
    -- FACTORES DE CONTEO Y PRORRATEO
    -- ----------------------------------------------------------

    -- Base para conteo absoluto de personas.
    -- Fijo en 1 por diseno Kimball. CHECK protege contra errores ETL.
    Headcount           SMALLINT        NOT NULL    DEFAULT 1,

    -- Factor de estandarizacion por tiempo completo (Full-Time Equivalent).
    -- 1.0000 = empleado a tiempo completo.
    -- < 1.0000 = practicante o empleado a tiempo parcial.
    -- 0.0000 permitido para empleados en Licencia Sin Goce o Suspendido.
    -- KPI: FTE Normalizado = SUMX(fact_Planilla, Salario_Base * FTE)
    FTE                 NUMERIC(5,4)    NOT NULL,

    -- Dias efectivamente pagados en el mes (0 a 31).
    -- Evita falsos positivos en Compa-ratio para meses incompletos
    -- (ingresos a mitad de mes, ceses parciales, licencias sin goce).
    Dias_Pagados        SMALLINT        NOT NULL,

    -- ----------------------------------------------------------
    -- MEDIDAS MONETARIAS (Soles peruanos S/)
    -- ----------------------------------------------------------

    -- Haber basico mensual del colaborador.
    -- >= 0: permite cero en Licencia Sin Goce mes completo.
    -- KPI: Masa Salarial = SUM(Salario_Base)
    -- KPI: Compa-ratio = Salario_Base / Banda_Salarial_Max de dim_Piramide
    Salario_Base        NUMERIC(10,2)   NOT NULL,

    -- Componente variable de compensacion (bonos, comisiones).
    -- DEFAULT 0.00: la mayoria de colaboradores no tiene bono mensual fijo.
    Bono_Variable       NUMERIC(10,2)   NOT NULL    DEFAULT 0.00,

    -- Costo de horas trabajadas fuera del horario regular.
    -- DEFAULT 0.00: no todos los meses generan horas extras.
    Costo_Horas_Extras  NUMERIC(10,2)   NOT NULL    DEFAULT 0.00,

    -- Cargas sociales, EPS y provisiones agrupadas.
    -- DEFAULT 0.00: Terceros y practicantes pueden tener estructura distinta.
    -- DEUDA TECNICA: en modelo productivo se separaria en tres columnas
    -- independientes (cargas sociales / EPS / provisiones).
    Beneficios          NUMERIC(10,2)   NOT NULL    DEFAULT 0.00,

    -- NOTA: Costo Total del Empleador (CTC) NO existe como columna.
    -- Es una medida DAX calculada en Power BI:
    --   CTC = [Salario_Base] + [Bono_Variable] + [Costo_Horas_Extras] + [Beneficios]

    -- ----------------------------------------------------------
    -- AUDITORIA Y CONTROL
    -- ----------------------------------------------------------

    -- TRUE si el registro fue generado despues del corte del dia 20.
    -- El ETL usa datos reales hasta el dia 20 y proyeccion lineal el resto.
    -- Medidas de masa salarial confirmada deben filtrar Es_Proyeccion = FALSE.
    Es_Proyeccion       BOOLEAN         NOT NULL    DEFAULT FALSE,

    -- Timestamp de carga al Data Warehouse. Trazabilidad de linaje ETL.
    Fecha_Carga_DW      TIMESTAMP       NOT NULL    DEFAULT CURRENT_TIMESTAMP,

    -- ----------------------------------------------------------
    -- PRIMARY KEY
    -- ----------------------------------------------------------
    CONSTRAINT pk_fact_Planilla
        PRIMARY KEY (ID_Fact_Planilla),

    -- ----------------------------------------------------------
    -- FOREIGN KEYS
    -- ----------------------------------------------------------
    CONSTRAINT fk_planilla_calendario
        FOREIGN KEY (Fecha_Llave)
        REFERENCES dim_Calendario (Fecha_Llave),

    CONSTRAINT fk_planilla_asociado
        FOREIGN KEY (ID_Asociado)
        REFERENCES dim_Asociados (ID_Asociado),

    CONSTRAINT fk_planilla_piramide
        FOREIGN KEY (ID_Piramide_Tecnico)
        REFERENCES dim_Piramide (ID_Piramide_Tecnico),

    CONSTRAINT fk_planilla_operacion
        FOREIGN KEY (ID_Operacion)
        REFERENCES dim_Operaciones (ID_Operacion),

    -- Relacion inactiva en Power BI. Ver comentario en columna ID_Supervisor.
    CONSTRAINT fk_planilla_supervisor
        FOREIGN KEY (ID_Supervisor)
        REFERENCES dim_Asociados (ID_Asociado),

    CONSTRAINT fk_planilla_estado
        FOREIGN KEY (ID_Estado_Nomina)
        REFERENCES dim_Estado_Nomina (ID_Estado_Nomina),

    -- ----------------------------------------------------------
    -- CHECK CONSTRAINTS
    -- ----------------------------------------------------------

    -- Headcount fijo en 1 por diseno. Protege contra errores de mapeo ETL.
    CONSTRAINT chk_headcount
        CHECK (Headcount = 1),

    -- FTE entre 0 y 1. Cero permitido para suspendidos y licencia sin goce.
    CONSTRAINT chk_fte_rango
        CHECK (FTE >= 0 AND FTE <= 1.0000),

    -- Dias pagados entre 0 y 31.
    CONSTRAINT chk_dias_pagados
        CHECK (Dias_Pagados >= 0 AND Dias_Pagados <= 31),

    -- Salario base >= 0. Permite cero en Licencia Sin Goce mes completo.
    CONSTRAINT chk_salario_base
        CHECK (Salario_Base >= 0),

    -- Componentes monetarios no pueden ser negativos.
    CONSTRAINT chk_bono_positivo
        CHECK (Bono_Variable >= 0),

    CONSTRAINT chk_hhee_positivo
        CHECK (Costo_Horas_Extras >= 0),

    CONSTRAINT chk_beneficios_positivo
        CHECK (Beneficios >= 0),

    -- Supervisor no puede ser el mismo colaborador.
    -- La cuspide de la piramide usa GC000, no su propio ID.
    CONSTRAINT chk_supervisor_distinto
        CHECK (ID_Supervisor != ID_Asociado)

);

COMMENT ON TABLE fact_Planilla IS
    'Tabla de hechos principal. Periodic Snapshot: 1 fila por empleado por mes. '
    'CTC no existe como columna: es medida DAX = Salario_Base + Bono_Variable + Costo_Horas_Extras + Beneficios. '
    'Headcount Activo: filtrar via dim_Estado_Nomina[Es_Headcount_Activo] = TRUE. '
    'ID_Supervisor usa relacion inactiva en Power BI: activar con USERELATIONSHIP en DAX.';

COMMENT ON COLUMN fact_Planilla.ID_Piramide_Tecnico IS
    'Surrogate key SCD Tipo 2 de dim_Piramide. '
    'Congela la version exacta del puesto (banda salarial, nivel) vigente en el mes. '
    'NUNCA reemplazar por ID_Piramide (smart key).';

COMMENT ON COLUMN fact_Planilla.ID_Supervisor IS
    'Role-playing dimension sobre dim_Asociados. '
    'Relacion INACTIVA en Power BI. Activar con: '
    'USERELATIONSHIP(fact_Planilla[ID_Supervisor], dim_Asociados[ID_Asociado]). '
    'GC000 = Sin Supervisor (cuspide organizacional). '
    'RESTRICCION MVP: los atributos del supervisor reflejan su estado actual '
    'en dim_Asociados sin trazabilidad historica. Deuda tecnica documentada.';

COMMENT ON COLUMN fact_Planilla.Beneficios IS
    'Agrupa cargas sociales, EPS y provisiones. '
    'DEUDA TECNICA: en modelo productivo se separaria en columnas independientes. '
    'Decision de alcance del MVP, no error de diseno.';

COMMENT ON COLUMN fact_Planilla.Es_Proyeccion IS
    'ETL corta con datos reales el dia 20 del mes. '
    'TRUE = registro generado con proyeccion lineal para dias 21 al cierre. '
    'Filtrar Es_Proyeccion = FALSE para medidas de masa salarial confirmada.';


