-- ============================================
-- FACT_AUSENTISMO — Semana 1 (SELECT / WHERE / ORDER BY)
-- Grano: evento de ausencia. Dataset chico (115 filas) — cuidado al generalizar.
-- ============================================

-- 1. Eventos con más de 5 días hábiles perdidos
select * from fact_ausentismo
where dias_habiles_perdidos > 5
order by dias_habiles_perdidos desc;

-- 2. Tipos de ausencia existentes
select distinct tipo_ausencia from fact_ausentismo;

-- 3. Eventos sin documentación
select distinct tiene_documentacion from fact_ausentismo;

select * from fact_ausentismo
where tiene_documentacion = 0;

-- 4. Eventos del primer semestre 2026
select * from fact_ausentismo
where fecha_inicio_ausencia between '2026-01-01' and '2026-06-30';

-- 5. Top 10 eventos con más días hábiles perdidos
select * from fact_ausentismo
order by dias_habiles_perdidos desc
limit 10;

-- 6. Eventos con duración mayor a 30 días calendario
-- Nota: resta directa entre columnas date devuelve días (integer) en Postgres,
-- no requiere AGE() (esa función es para formato años/meses/días, como edad)
select * from fact_ausentismo
where fecha_fin_ausencia - fecha_inicio_ausencia > 30;


-- ============================================
-- FACT_NOVEDADES — Semana 1 (SELECT / WHERE / ORDER BY)
-- Grano: evento de movimiento/novedad
-- ============================================

-- 7. Estados existentes de estado_novedad
select distinct estado_novedad from fact_novedades;
-- Hallazgo: todas las novedades están en estado "Aprobado"

-- 8. Novedades sin resolver
-- Resultado: 0 filas (consistente con el hallazgo de la pregunta 7)

-- 9. Novedades con cambio real de piramide (cargo/departamento distinto)
select * from fact_novedades
where id_piramide_origen <> id_piramide_destino;

-- 10. Novedades que son consecuencia de otro movimiento (id_fact_novedad_padre no nulo)
select distinct id_fact_novedad_padre from fact_novedades;

select * from fact_novedades
where id_fact_novedad_padre is not null;

-- 11. Novedades de 2025, ordenadas por fecha efectiva
select * from fact_novedades
where fecha_efectiva_llave between '2025-01-01' and '2025-12-31'
order by fecha_efectiva_llave;

-- 12. Novedades con motivo_novedad nulo
select distinct motivo_novedad from fact_novedades;

select * from fact_novedades
where motivo_novedad is null;

-- 13. Cantidad de novedades por tipo (id_tipo_novedad crudo; nombre se resuelve con JOIN en Semana 3)
select count(*), id_tipo_novedad from fact_novedades
group by id_tipo_novedad
order by count(*) desc;
