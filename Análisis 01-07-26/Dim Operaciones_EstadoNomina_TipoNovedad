-- ============================================
-- DIM_OPERACIONES — Semana 1 (SELECT / WHERE / ORDER BY)
-- Nota: se usa fecha_finalizacion en vez de estado_proyecto para determinar
-- "activo" al corte 01-jul-2026, ya que estado_proyecto no está alineado a ese corte
-- ============================================

-- 1. Proyectos activos al corte (sin fecha de fin, o fecha de fin posterior al corte)
select * from dim_operaciones
where tipo_operacion <> 'Dummy' 
  and (fecha_finalizacion is null or fecha_finalizacion >= '2026-07-01');

-- 2. Proyectos ya finalizados (fecha_finalizacion no nula)
select * from dim_operaciones
where tipo_operacion <> 'Dummy' and fecha_finalizacion is not null;

-- 3. Proyectos con meta_facturacion mayor a su presupuesto_asignado
select * from dim_operaciones
where tipo_operacion <> 'Dummy' and meta_facturacion > presupuesto_asignado;

-- 4. Proyectos con mayor presupuesto asignado
select * from dim_operaciones
where tipo_operacion not in ('Dummy','Back-Office')
order by presupuesto_asignado desc;

-- 5. Proyectos de larga duración (iniciaron antes de 2023 y siguen activos)
select * from dim_operaciones
where tipo_operacion not in ('Dummy','Back-Office') 
  and fecha_inicio < '2023-01-01'
  and (fecha_finalizacion is null or fecha_finalizacion >= '2026-07-01');

-- 6. Clientes distintos en la cartera
select distinct cliente from dim_operaciones;


-- ============================================
-- DIM_ESTADO_NOMINA — Semana 1
-- ============================================

-- 7. Todos los estados de nómina con su descripción
select estado, descripcion from dim_estado_nomina;

-- 8. Estados que cuentan como headcount activo
select estado, es_headcount_activo from dim_estado_nomina
where es_headcount_activo = true;

-- 9. Estados que NO cuentan como headcount activo
select estado, es_headcount_activo from dim_estado_nomina
where es_headcount_activo = false;


-- ============================================
-- DIM_TIPO_NOVEDAD — Semana 1
-- ============================================

-- 10. Tipos de novedad agrupados por categoría
select * from dim_tipo_novedad
order by categoría;

-- 11. Cantidad de tipos de novedad por categoría
select count(*) as tiposnovedad, categoria from dim_tipo_novedad
group by categoria;

-- 12. Tipos de novedad sin descripción
select * from dim_tipo_novedad
where descripcion is null;
