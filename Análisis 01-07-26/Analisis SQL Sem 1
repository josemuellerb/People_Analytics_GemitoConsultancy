-- ============================================
-- DIM_ASOCIADOS
-- Fecha de corte del análisis: 2026-07-01
-- Regla de negocio "activo": estado_asociado = 'Activo' AND fecha_ingreso <= '2026-07-01'
-- ============================================

-- 1. Listado completo de asociados activos actualmente
select * 
from dim_asociados 
where estado_asociado = 'Activo' 
  and fecha_ingreso <= '2026-07-01';

-- 2. Valores distintos en columnas categóricas clave
select distinct estado_asociado from dim_asociados;
select distinct tipo_contrato from dim_asociados;
select distinct nivel_educativo from dim_asociados;
select distinct nacionalidad from dim_asociados;
select distinct genero from dim_asociados;

-- 3. Los 10 asociados de mayor y menor edad (activos al corte)
select id_asociado, apellidos_nombres, fecha_nacimiento, age('2026-07-01', fecha_nacimiento) as edad
from dim_asociados
where estado_asociado = 'Activo' and fecha_ingreso <= '2026-07-01'
order by edad desc
limit 10;

select id_asociado, apellidos_nombres, fecha_nacimiento, age('2026-07-01', fecha_nacimiento) as edad
from dim_asociados
where estado_asociado = 'Activo' and fecha_ingreso <= '2026-07-01'
order by edad asc
limit 10;

-- 4. Cantidad de asociados por género
select count(*) from dim_asociados
where estado_asociado = 'Activo' and fecha_ingreso <= '2026-07-01' and genero = 'Masculino';

select count(*) from dim_asociados
where estado_asociado = 'Activo' and fecha_ingreso <= '2026-07-01' and genero = 'Femenino';

-- 5. Nacionalidad predominante y distribución
select nacionalidad, count(*) as empleados 
from dim_asociados 
where estado_asociado = 'Activo' and fecha_ingreso <= '2026-07-01'
group by nacionalidad;
-- Resultado: 365 Local / 38 Extranjero → predominante es "Local"

-- 6. Los 15 asociados con mayor antigüedad
select * from dim_asociados
where fecha_ingreso <= '2026-07-01' and estado_asociado = 'Activo'
order by fecha_ingreso
limit 15;

-- 7. Asociados ingresados por año (2022–2026)
select * from dim_asociados
where estado_asociado = 'Activo' and fecha_ingreso between '2022-01-01' and '2022-12-31'
order by fecha_ingreso;
-- (repetir cambiando el rango para 2023, 2024, 2025, y 2026 hasta 2026-07-01)

-- 8. Asociados cesados en un rango específico (ej. 2024)
select * from dim_asociados
where fecha_cese between '2024-01-01' and '2024-12-31'
order by fecha_cese;

-- 9. Activos con más de 1 año de antigüedad al corte (candidatos a revisión de banda)
select * from dim_asociados
where fecha_ingreso between '2022-01-01' and '2025-07-31' and estado_asociado = 'Activo'
order by fecha_ingreso;

-- 10. Asociados con nivel educativo de Maestría (activos al corte), ordenados de más jóvenes a mayores
select id_asociado, apellidos_nombres, fecha_nacimiento, age('2026-07-01', fecha_nacimiento) as edad
from dim_asociados
where nivel_educativo = 'Maestría' and estado_asociado = 'Activo' and fecha_ingreso <= '2026-07-01'
order by edad asc;

-- 11. Frecuencia de carreras profesionales (adelanto de GROUP BY)
select carrera_profesional, count(*) 
from dim_asociados
where estado_asociado = 'Activo' and fecha_ingreso <= '2026-07-01'
group by carrera_profesional;

-- 12. Asociados sin correo corporativo asignado
select * from dim_asociados 
where estado_asociado = 'Activo' and fecha_ingreso <= '2026-07-01'
and upn_corporativo is null;

-- 13. Asociados con tipo_contrato distinto a "Indeterminado"
select * from dim_asociados 
where estado_asociado = 'Activo' and fecha_ingreso <= '2026-07-01'
and tipo_contrato <> 'Indeterminado';

-- 14. Asociados con contrato temporal (Plazo Fijo / Prácticas)
select * from dim_asociados 
where estado_asociado = 'Activo' and fecha_ingreso <= '2026-07-01'
and tipo_contrato in ('Prácticas Pre-Profesionales', 'Plazo Fijo');

-- 15. Búsqueda por texto en apellidos_nombres (LIKE / ILIKE)
select * from dim_asociados where estado_asociado = 'Activo' and fecha_ingreso <= '2026-07-01'
and apellidos_nombres ilike '%juan%';   -- contiene "juan"

select * from dim_asociados where estado_asociado = 'Activo' and fecha_ingreso <= '2026-07-01'
and apellidos_nombres ilike 'M%';        -- empieza con "M"

select * from dim_asociados where estado_asociado = 'Activo' and fecha_ingreso <= '2026-07-01'
and apellidos_nombres ilike '%JUAN';     -- termina con "JUAN"


-- ============================================
-- DIM_CALENDARIO
-- Tabla de soporte de fechas, sin métricas propias, pero clave para futuros JOINs (Semana 3)
-- ============================================

-- 1. Días del calendario que corresponden a fines de semana
select * from dim_calendario
where dia_semana_numero in (6,7);

-- 2. Cantidad de días feriados por año
select count(*), anio as año 
from dim_calendario
where es_feriado = 1
group by anio
order by anio;

-- 3. Fechas correspondientes al cierre de nómina (quincenas: 1 y 2)
select * from dim_calendario
where corte_nomina in (1,2);

-- 4. Días laborables netos por trimestre de 2025
select anio as año, trimestre, count(trimestre) as dias_laborales  
from dim_calendario
where dia_laborable_neto = 1 and anio = '2025'
group by trimestre, anio
order by trimestre;

-- 5. Fechas del segundo semestre de 2024, ordenadas cronológicamente
select anio, semestre, fecha_llave 
from dim_calendario
where semestre = 2 and anio = 2024
order by fecha_llave;

-- 6. Primera y última fecha registrada en el calendario (confirma cobertura de 4.5 años)
select min(fecha_llave), max(fecha_llave) 
from dim_calendario;


-- ============================================
-- DIM_PIRAMIDE
-- Estructura organizacional: cargos, jerarquía, criticidad y bandas salariales
-- ============================================

-- Estructura organizacional

-- 1. Cantidad de cargos distintos por departamento
select count(*) as ndecargos, departamento 
from dim_piramide
group by departamento;

-- 2. Cargos del nivel jerárquico más alto (orden_nivel_jerarquico = 5, confirmado como tope)
select * from dim_piramide
where orden_nivel_jerarquico = 5;

-- 3. Departamentos con más posiciones/cargos distintos
select count(*) as ndecargos, departamento 
from dim_piramide
group by departamento
order by count(*) desc;

-- Puestos críticos

-- 4. Cargos marcados como puesto crítico
select * from dim_piramide
where es_puesto_critico;

-- 5. Puestos críticos ordenados por banda salarial máxima (mayor riesgo económico ante rotación)
select cargo, banda_salarial_max 
from dim_piramide
where es_puesto_critico
order by banda_salarial_max desc;

-- Bandas salariales

-- 6. Cargos con el rango de banda salarial más amplio (max - min), excluyendo dummies
select cargo, banda_salarial_max - banda_salarial_min as amplitud, banda_salarial_midpoint 
from dim_piramide
where banda_salarial_max - banda_salarial_min > 0
order by amplitud desc;

-- 7. Cargos con banda salarial más alta y más baja según midpoint
select cargo, banda_salarial_midpoint
from dim_piramide
where cargo <> 'Desconocido'
order by banda_salarial_midpoint desc;

-- 8. Cargos sin banda_salarial_midpoint definido
select * from dim_piramide
where banda_salarial_midpoint is null;
-- Resultado: 0 filas → la columna está completa, sin nulos

-- Dotación / plazas

-- 9. Combinaciones cargo/departamento con más plazas autorizadas
select cargo, departamento, plazas_autorizadas
from dim_piramide
where cargo <> 'Desconocido'
order by plazas_autorizadas desc;

-- 10. Cargos con tipo_contrato_esperado distinto a "Indeterminado"
select * from dim_piramide
where tipo_contrato_esperado <> 'Indeterminado'
order by orden_nivel_jerarquico desc;


