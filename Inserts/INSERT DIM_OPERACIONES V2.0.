-- 1. Total registros (esperado: 12)
SELECT COUNT(*) AS total_registros FROM dim_Operaciones;

-- 2. Distribución por tipo
SELECT Tipo_Operacion, COUNT(*) AS total
FROM dim_Operaciones
GROUP BY Tipo_Operacion
ORDER BY total DESC;
-- Esperado: Proyecto=10, Back-Office=1, Dummy=1

-- 3. Meta siempre mayor al presupuesto en proyectos (esperado: 0 filas)
SELECT ID_Operacion, Presupuesto_Asignado, Meta_Facturacion
FROM dim_Operaciones
WHERE Tipo_Operacion = 'Proyecto'
  AND Meta_Facturacion <= Presupuesto_Asignado;

-- 4. Back-Office y Dummy con Meta_Facturacion = 0 (esperado: 2 filas)
SELECT ID_Operacion, Meta_Facturacion
FROM dim_Operaciones
WHERE Tipo_Operacion IN ('Back-Office', 'Dummy')
  AND Meta_Facturacion <> 0.00;
-- Esperado: 0 filas (ambos tienen Meta=0)

-- 5. Fechas coherentes — ningún cierre antes del inicio (esperado: 0)
SELECT ID_Operacion
FROM dim_Operaciones
WHERE Fecha_Finalizacion IS NOT NULL
  AND Fecha_Finalizacion < Fecha_Inicio;

-- 6. Proyectos activos en cada período clave
SELECT
    p.ID_Operacion,
    p.Nombre_Proyecto,
    p.Fecha_Inicio,
    p.Fecha_Finalizacion
FROM dim_Operaciones p
WHERE p.Tipo_Operacion = 'Proyecto'
ORDER BY p.Fecha_Inicio;
-- Verificar visualmente que Q1 2022 no tiene proyectos
-- y Q2 2022 arranca con P001 y P002

-- 7. Suma total Meta_Facturacion proyectos (esperado: S/ 36,968,750.00)
SELECT
    TO_CHAR(SUM(Meta_Facturacion), 'FM S/ 999,999,999.00') AS total_meta_facturacion
FROM dim_Operaciones
WHERE Tipo_Operacion = 'Proyecto';

-- 8. Margen bruto por proyecto (esperado: ~30% en todos)
SELECT
    ID_Operacion,
    Nombre_Proyecto,
    Presupuesto_Asignado,
    Meta_Facturacion,
    ROUND((Meta_Facturacion / NULLIF(Presupuesto_Asignado,0) - 1) * 100, 1)
        AS margen_pct
FROM dim_Operaciones
WHERE Tipo_Operacion = 'Proyecto'
ORDER BY Fecha_Inicio;
-- Esperado: 30.0% en todos los proyectos
